# Daily online backup of the LookingGlass database, for hosts that don't replicate it with Litestream.
# Started by lookingglass-backup.timer; install-linux.sh installs both but doesn't enable the timer:
#   sudo systemctl enable --now lookingglass-backup.timer
#
# The backup is SQLite's online backup, safe while the server runs. Each run writes
# /var/lib/lookingglass/backups/lookingglass-<UTC time>.db and keeps the newest 14.
# Copy that folder off the machine too: a backup on the same disk doesn't survive losing it.
# To restore one, see "Backups and restoring" in docs/server.md.

[Unit]
Description=LookingGlass database backup

[Service]
Type=oneshot
User=lookingglass
WorkingDirectory=/opt/lookingglass
ExecStart=/opt/lookingglass/LookingGlass.Server --backup /var/lib/lookingglass/backups/ --keep 14
Environment=LookingGlass__DataDirectory=/var/lib/lookingglass
StateDirectory=lookingglass
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
