<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <AssemblyName>LookingGlass</AssemblyName>
    <RootNamespace>LookingGlass.Plugin</RootNamespace>
    <Version>0.2.14</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LookingGlass.Core\LookingGlass.Core.csproj" />
    <ProjectReference Include="..\LookingGlass.Protocol\LookingGlass.Protocol.csproj" />
  </ItemGroup>

  <!--
    The game is 64-bit Windows (Wine and Proton run that same build), so of the native libraries NuGet packages bring
    (NSec's libsodium for 19 platforms, about 19 MB) only runtimes/win-x64 is ever loaded. The others are left out of the
    output, and so out of the release zip; the layout of the one kept is unchanged, so it loads as before.
  -->
  <Target Name="KeepOnlyWindowsX64Natives" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.DestinationSubDirectory)').Replace('/', '\').StartsWith('runtimes\'))
                                          And !$([System.String]::Copy('%(ReferenceCopyLocalPaths.DestinationSubDirectory)').Replace('/', '\').StartsWith('runtimes\win-x64\'))" />
    </ItemGroup>
  </Target>

  <!-- Ones an earlier build left in the output folder go too, before it is packed. -->
  <Target Name="RemoveOtherPlatformsNatives" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <OtherPlatformsNatives Include="$(OutDir)runtimes\**\*" Exclude="$(OutDir)runtimes\win-x64\**\*" />
    </ItemGroup>
    <Delete Files="@(OtherPlatformsNatives)" />
  </Target>

</Project>
