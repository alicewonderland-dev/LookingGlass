{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5180",
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 12000,
      "MaxConcurrentUpgradedConnections": 12000,
      "MaxRequestBodySize": 65536,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestLineSize": 8192,
      "KeepAliveTimeout": "00:01:00",
      "RequestHeadersTimeout": "00:00:15"
    }
  },
  "LookingGlass": {
    "DataDirectory": "data",
    "Announcement": "",
    "PublicUrls": [],
    "TrustedProxies": [],
    "Lodestone": {
      "BaseUrl": "https://na.finalfantasyxiv.com",
      "MinDelaySeconds": 2,
      "ChallengeMinutes": 15
    },
    "Dev": {
      "AllowDebugAccounts": false,
      "HostEchoBot": false,
      "AllowOutsideDevelopment": false,
      "EchoBotName": "Echo Bot",
      "EchoBotServerUrl": ""
    },
    "Database": {
      "CheckpointMinutes": 0
    },
    "Messages": {
      "KeepDays": 7,
      "MaxPerChannel": 5000
    },
    "Limits": {
      "RegistrationsPerHourPerIp": 5,
      "KeyLoginsPerHourPerIp": 60,
      "KeyLoginFailuresPerHourPerIp": 10,
      "ConnectionsPerIp": 20,
      "NotLoggedInConnectionsPerIp": 4,
      "NotLoggedInSeconds": 180,
      "MaxConnections": 10000,
      "ConnectionsPerMinutePerIp": 60,
      "RequestsPerSecondPerConnection": 20,
      "RequestBurstPerConnection": 200,
      "MaxIdentitiesPerRequest": 500,
      "SendQueueLength": 256,
      "InviteBurstPerInviter": 60,
      "InviteIntervalSecondsPerInviter": 5,
      "InviteBurstPerInvitee": 30,
      "InviteIntervalSecondsPerInvitee": 10,
      "InviteBurstPerPair": 20,
      "InviteIntervalSecondsPerPair": 60,
      "MaxPendingInvitesPerUser": 50,
      "MaxPendingInvitesFromOneInviter": 25,
      "LookupBurst": 60,
      "LookupIntervalSeconds": 1
    }
  }
}
